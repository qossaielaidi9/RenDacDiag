# Copier en .env et adapter
RDD_TEXT_EMBEDDER=bge-m3        # ou hash (tests, sans modèle)
RDD_IMAGE_EMBEDDER=clip         # ou none
RDD_QDRANT_URL=                 # vide = Qdrant local sur disque ; http://localhost:6333 avec docker-compose
RDD_INCLUDE_UNVERIFIED=0        # 1 uniquement en développement
RDD_JWT_SECRET=                 # chaîne aléatoire de 64 caractères (python -c "import secrets;print(secrets.token_hex(32))")
RDD_RATE_PER_MINUTE=30
